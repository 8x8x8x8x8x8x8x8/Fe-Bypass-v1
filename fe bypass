-- StarterGui.ScreenGui.Frame.EXECUTE.LocalScript
local function C_12()
local script = G2L["12"];
	local button = script.Parent
	local textBox = button.Parent.editorBox
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local httpProxy = ReplicatedStorage:WaitForChild("HttpGetProxy")
	
	-- Create a game proxy that supports game:HttpGet(url) by proxying through the server
	local realGame = game
	local function createGameProxy()
		return setmetatable({}, {
			__index = function(t, k)
				if k == "HttpGet" then
					return function(_, url)
						return httpProxy:InvokeServer(url)
					end
				elseif k == "HttpPost" then
					return function(_, url, body)
						return httpProxy:InvokeServer(url, body)
					end
				end
				local val = realGame[k]
				if type(val) == "function" then
					return function(_, ...)
						return val(realGame, ...)
					end
				end
				return val
			end,
		})
	end
	
	button.MouseButton1Click:Connect(function()
		local code = textBox.Text
		if code == "" then return end
	
		local fn, err = loadstring(code)
		if fn then
			-- Set up environment with game proxy so game:HttpGet works
			local env = setmetatable({
				game = createGameProxy(),
			}, { __index = getfenv() })
			setfenv(fn, env)
	
			local ok, execErr = pcall(fn)
			if not ok then
				warn("[ClientExecutor] Runtime error: " .. tostring(execErr))
			end
		else
			warn("[ClientExecutor] Compile error: " .. tostring(err))
		end
	end)
end;
task.spawn(C_12);
